# Copy to .env (mode 0600, never committed). Only the host tools read this file; the production server holds no keys.
# Created by `npm run test-wallet:keys`, which fills any missing value and never replaces an existing one.

# Test wallet, BCH mainnet: 12 word BIP39 phrase (path m/44'/145'/0'/0/0). Small amounts only.
SAMPAN_TEST_BCH_PHRASE=""
# Test wallet, BCH chipnet: a separate 12 word BIP39 phrase.
SAMPAN_TEST_CHIPNET_PHRASE=""
# Test EVM key: 0x followed by 64 hex digits.
SAMPAN_TEST_EVM_KEY=
