pragma cashscript ^0.14.0;

// Landing address. Any BCH that reaches this contract can only leave it to the owner:
// as fungible tokens of one category at a rate at or above the minimum (convert),
// or, once the coin is returnAfter blocks old, as plain BCH (giveBack).
// No key of the service is involved: anyone may finish either path.
contract Landing(
    // Full locking bytecode of the owner's address (25 bytes P2PKH or 23 bytes P2SH), not a hash.
    bytes ownerLock,
    // Token category in transaction byte order (the reverse of the hex id shown by explorers).
    bytes32 tokenCategory,
    // Minimum token base units per rateDen satoshis.
    int rateNum,
    int rateDen,
    // Relative age in blocks after which the BCH may be returned.
    int returnAfter
) {
    function convert() {
        require(this.activeInputIndex == 0);
        // No extra outputs: output i pairs with input i (owner first, then the pools).
        require(tx.outputs.length == tx.inputs.length);
        require(tx.outputs[0].lockingBytecode == ownerLock);
        // Fungible tokens only: an NFT would append a capability byte to the category.
        require(tx.outputs[0].tokenCategory == tokenCategory);
        require(tx.outputs[0].tokenAmount * rateDen >= tx.inputs[0].value * rateNum);
    }

    function giveBack() {
        require(this.activeInputIndex == 0);
        require(this.age >= returnAfter);
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == ownerLock);
        require(tx.outputs[0].tokenCategory == 0x);
        require(tx.outputs[0].value >= tx.inputs[0].value - 1000);
    }
}
