{
  "name": "sampan",
  "version": "0.1.0",
  "private": true,
  "description": "Dollar stablecoins in and out of Bitcoin Cash.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup",
    "start": "node dist/server/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "gate": "bash scripts/gerbang-ujian.sh",
    "test-wallet:keys": "tsx tools/test-wallet/keys.ts",
    "test-wallet": "tsx tools/test-wallet/connect.ts",
    "test-wallet:send": "tsx tools/test-wallet/send.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.6",
    "@cashlab/cauldron": "^1.0.3",
    "@cashlab/common": "^1.0.5",
    "@electrum-cash/network": "4.4.8",
    "@fastify/static": "^10.1.11",
    "@wizardconnect/core": "0.2.10",
    "@wizardconnect/dapp": "0.2.7",
    "@wizardconnect/react": "0.2.6",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wizardconnect/wallet": "0.2.4",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
