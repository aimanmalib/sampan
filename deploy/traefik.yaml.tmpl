# Route for the public host name to the sampan container, on its own router so a certificate problem here
# cannot affect any other name. deploy/deploy.sh fills the @...@ values from deploy/hos.env and copies the
# result into the proxy's dynamic configuration folder.
# HTML is sent with `Cache-Control: no-transform`, so a CDN in front does not compress it: the `compress`
# middleware does, with its 1024-byte floor lowered so the small index page is compressed too.
http:
  routers:
    sampan:
      entryPoints: [https]
      rule: Host(`@DOMAIN@`)
      service: sampan-svc
      middlewares: [sampan-compress]
      tls:
        certResolver: @CERT_RESOLVER@
      priority: 100
    sampan-http:
      entryPoints: [http]
      rule: Host(`@DOMAIN@`)
      service: sampan-svc
      middlewares: [sampan-https]
      priority: 100
  middlewares:
    sampan-compress:
      compress:
        minResponseBodyBytes: 256
        excludedContentTypes: [image/png, image/jpeg, image/webp, font/woff2]
    sampan-https:
      redirectScheme:
        scheme: https
        permanent: true
  services:
    sampan-svc:
      loadBalancer:
        servers:
          - url: http://sampan:8080
