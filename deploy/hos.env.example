# Copy to deploy/hos.env (not tracked) and fill in the values of the host that runs the container.
SAMPAN_DOMAIN=sampan.example.com
MEDIA_DOMAIN=sampan-media.example.com # second name for the video files, NOT proxied by a CDN; must equal config media.host
SAMPAN_NETWORK=proxy               # existing Docker network shared with the reverse proxy
PROXY_CONTAINER=proxy              # reverse proxy container (Traefik v3, file provider)
PROXY_DYNAMIC_DIR=/traefik/dynamic # file provider folder inside that container
CERT_RESOLVER=letsencrypt
BUILD_CMD="docker build"           # anything that accepts `docker build` arguments
MIN_FREE_GB=8
BROWSER_CMD=                       # optional prefix for the browser check, e.g. a queue wrapper
SAMPAN_NODE=                       # full path of a Node 22 binary for the cron jobs (the system node is older)
NOTIFY_CMD=                        # optional: command "<text>" <info|warn> used by uptime.sh
SAMPAN_TEST_ADDRESSES=                # optional: comma-separated addresses of the team's own wallets, counted as test runs
SAMPAN_PAY_DEMO_SECRET=               # optional: whsec_ + base64 of 32 random bytes; the demo shop hook (Sampan Pay) is 404 without it
